<Window
    x:Class="Harness.App.Views.WorkingTreeWindow"
    x:DataType="vm:WorkingTreeWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Harness.App.ViewModels"
    Title="Harness — Working Tree"
    Width="1120"
    Height="760"
    MinWidth="780"
    MinHeight="500"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="44"
    WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="44,*,28">
    <Border Grid.Row="0" Classes="hairline" Background="#151A21" PointerPressed="TitleBar_OnPointerPressed">
      <Grid Margin="14,0,0,0" ColumnDefinitions="Auto,14,Auto,*,Auto,8,Auto,40,40,40">
        <TextBlock Text="WORKING TREE" Classes="micro" Foreground="#D8DEE8" VerticalAlignment="Center" />
        <Border Grid.Column="1" Width="1" Height="18" Background="#29313C" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Branch}" Classes="mono" FontSize="10" />
          <TextBlock Text="{Binding Status}" Classes="micro" FontSize="8" Foreground="#65C7D0" />
        </StackPanel>
        <Button x:Name="RenameBranchButton" Grid.Column="4" Content="RENAME BRANCH" Classes="ghost" Click="RenameBranch_OnClick" />
        <Button Grid.Column="6" Content="REFRESH" Classes="ghost" Click="Refresh_OnClick" />
        <Button Grid.Column="7" Classes="window-command" Click="Minimize_OnClick"><Border Width="12" Height="1.5" Background="#D8DEE8"/></Button>
        <Button x:Name="MaximizeButton" Grid.Column="8" Classes="window-command" Click="Maximize_OnClick"><Border Width="11" Height="11" BorderBrush="#D8DEE8" BorderThickness="1.5"/></Button>
        <Button Grid.Column="9" Classes="window-command window-close" Click="Close_OnClick"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#D8DEE8" StrokeThickness="1.5" Data="M3,3 L13,13 M13,3 L3,13"/></Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="360,*">
      <Border Grid.Column="0" BorderBrush="#29313C" BorderThickness="0,0,1,0" Background="#151A21">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Margin="14,13" Text="CHANGED FILES" Classes="micro" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Files}"
                   SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                   SelectionChanged="FileSelection_OnChanged"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkingTreeFileItem">
                <StackPanel Margin="8,6" Spacing="6">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="{Binding StatusCode}" Classes="micro mono" FontSize="8" Foreground="#E2A84A" />
                    <TextBlock Grid.Column="1" Text="{Binding RelativePath}" Classes="mono" FontSize="10" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto,4,Auto,4,Auto">
                    <TextBlock Text="{Binding StatusLabel}" Classes="muted" FontSize="8" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="STAGE" Tag="{Binding}" Classes="ghost" Padding="5,0" IsEnabled="{Binding CanStage}" Click="Stage_OnClick" />
                    <Button Grid.Column="3" Content="UNSTAGE" Tag="{Binding}" Classes="ghost" Padding="5,0" IsEnabled="{Binding CanUnstage}" Click="Unstage_OnClick" />
                    <Button Grid.Column="5" Content="REVERT" Tag="{Binding}" Classes="ghost" Padding="5,0" IsEnabled="{Binding CanRevert}" Click="Revert_OnClick" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="42,*" Background="#11151B">
        <Grid Margin="14,0" ColumnDefinitions="*,Auto,16,Auto" VerticalAlignment="Center">
          <TextBlock Text="DIFF" Classes="micro" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedFile.RelativePath}" Classes="muted mono" FontSize="9" />
          <TextBlock Grid.Column="3" Text="{Binding DiffSummary}" Classes="mono" FontSize="10" Foreground="#65C7D0" />
        </Grid>
        <Border Grid.Row="1" Margin="12" BorderBrush="#29313C" BorderThickness="1" CornerRadius="4" Background="#0F1318">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DiffLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiffLineItem">
                  <Border Background="{Binding Background}" MinHeight="20">
                    <Grid ColumnDefinitions="44,44,22,*">
                      <TextBlock Text="{Binding OldLine}" Classes="muted mono" FontSize="9" TextAlignment="Right" Padding="0,2,8,2" Background="#151A21" />
                      <TextBlock Grid.Column="1" Text="{Binding NewLine}" Classes="muted mono" FontSize="9" TextAlignment="Right" Padding="0,2,8,2" Background="#151A21" />
                      <TextBlock Grid.Column="2" Text="{Binding Marker}" Classes="mono" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Foreground}" TextAlignment="Center" Padding="0,2" />
                      <TextBlock Grid.Column="3" Text="{Binding Text}" Classes="mono" FontSize="10" Foreground="{Binding Foreground}" Padding="4,2,12,2" TextWrapping="NoWrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" BorderBrush="#29313C" BorderThickness="0,1,0,0" Background="#0D1116">
      <TextBlock Text="{Binding Activity}" Classes="muted mono" FontSize="9" Margin="11,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
