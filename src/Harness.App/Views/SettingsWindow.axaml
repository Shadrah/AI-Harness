<Window
    x:Class="Harness.App.Views.SettingsWindow"
    x:DataType="vm:SettingsWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Harness.App.ViewModels"
    Title="Harness — Settings"
    Width="1480" Height="880" MinWidth="1120" MinHeight="700"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="64,*,42" Background="#11151B">
    <Border Classes="hairline" Background="#151A21" Padding="20,0">
      <StackPanel VerticalAlignment="Center" Spacing="3">
        <TextBlock Text="HARNESS SETTINGS" Classes="micro" Foreground="#65C7D0" />
        <TextBlock Text="Keep the workspace focused. Configure the machinery here." Classes="muted" FontSize="11" />
      </StackPanel>
    </Border>

    <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" Margin="14">
      <TabItem Header="WORKSPACE">
        <ScrollViewer><StackPanel Margin="24,8" Spacing="18" MaxWidth="620">
          <StackPanel Spacing="4"><TextBlock Text="Workspace surface" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose which live development signals stay visible while you work." Classes="muted"/></StackPanel>
          <CheckBox Content="Show live usage" IsChecked="{Binding ShowUsageInspector}"/>
          <CheckBox Content="Show attached context" IsChecked="{Binding ShowContextInspector}"/>
          <CheckBox Content="Show turn diff shortcut" IsChecked="{Binding ShowTurnDiffInspector}"/>
          <TextBlock Text="Working tree remains available as a separate module because it is active development state." Classes="muted" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="IMPORTS">
        <StackPanel Margin="24,8" Spacing="18" MaxWidth="640">
          <StackPanel Spacing="4"><TextBlock Text="Bring projects into Harness" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Migrate a project, its detected chat history, and recognized instruction files without keeping the original harness installed." Classes="muted" TextWrapping="Wrap"/></StackPanel>
          <Border Classes="panel" Padding="16"><StackPanel Spacing="10">
            <TextBlock Text="INSTALLED HARNESS HISTORY" Classes="micro" Foreground="#65C7D0"/>
            <TextBlock Text="Groups Codex and Claude Code history by source project. Internal subagents and Harness-created provider threads are excluded. Importing opens the latest root continuation and copies recognized context files into Harness-owned storage." TextWrapping="Wrap"/>
            <Button Content="SCAN INSTALLED HARNESSES" HorizontalAlignment="Left" Click="ScanHarnesses_OnClick"/>
          </StackPanel></Border>
          <Border Classes="panel" Padding="16"><StackPanel Spacing="10">
            <TextBlock Text="CONVERSATION EXPORT" Classes="micro" Foreground="#65C7D0"/>
            <TextBlock Text="Reads Markdown, text, JSON, and JSONL exports. Harness previews the detected messages and loss boundary before writing anything." TextWrapping="Wrap"/>
            <Button Content="CHOOSE EXPORT…" HorizontalAlignment="Left" Click="ImportConversation_OnClick"/>
          </StackPanel></Border>
          <Border Classes="panel" Padding="16"><StackPanel Spacing="10">
            <TextBlock Text="PROJECT FOLDER" Classes="micro" Foreground="#65C7D0"/>
            <TextBlock Text="Register another project folder and continue there. Conversation import is available after the project opens." TextWrapping="Wrap"/>
            <Button Content="OPEN PROJECT FOLDER…" HorizontalAlignment="Left" Click="OpenProject_OnClick"/>
          </StackPanel></Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="PERSONALIZATION">
        <StackPanel Margin="24,8" Spacing="14" MaxWidth="640">
          <TextBlock Text="Personalization" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Standing instructions delivered through each provider's native developer-instruction channel. Saving updates the active provider thread without adding visible or ghost chat text." Classes="muted" TextWrapping="Wrap"/>
          <TextBox Text="{Binding PersonalInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" Watermark="Coding conventions, response preferences, and standing project habits…"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="STARTUP">
        <StackPanel Margin="24,8" Spacing="16" MaxWidth="620">
          <TextBlock Text="Startup" FontSize="22" FontWeight="SemiBold"/>
          <CheckBox Content="Restore the last workspace and session" IsChecked="{Binding RestoreLastWorkspace}"/>
          <TextBlock Text="Provider connections and model catalogs refresh in the background. Sign-in is shown only when a connection expires or is missing." Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="PROVIDERS">
        <ScrollViewer><StackPanel Margin="24,8" Spacing="16" MaxWidth="850">
          <TextBlock Text="Providers" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Codex subscription access remains separate from API connections. API requests use the provider's billing and quotas, not your chat subscription. Claude.ai subscriptions cannot be connected to third-party harnesses." Classes="muted" TextWrapping="Wrap"/>
          <Border x:Name="ApiConnectionPanel" Classes="panel" Padding="16"><StackPanel Spacing="10">
            <TextBlock Text="API CONNECTIONS" Classes="micro" Foreground="#65C7D0"/>
            <ComboBox x:Name="ApiSavedConnections" HorizontalAlignment="Stretch" PlaceholderText="Choose a saved connection" SelectionChanged="ApiSavedConnection_OnChanged"/>
            <Grid ColumnDefinitions="*,12,*">
              <ComboBox x:Name="ApiProviderPicker" HorizontalAlignment="Stretch" SelectionChanged="ApiProvider_OnChanged"/>
              <TextBox x:Name="ApiConnectionName" Grid.Column="2" Watermark="Connection name"/>
            </Grid>
            <TextBox x:Name="ApiEndpoint" Watermark="API base URL, including /v1/ where required"/>
            <TextBox x:Name="ApiKey" PasswordChar="●" Watermark="API key · leave blank to keep the saved key"/>
            <TextBlock Text="Keys are stored in Windows Credential Manager, never in workspace files. Connect checks the catalog only; it does not make a billable generation request. Local examples: LM Studio port 1234, Ollama port 11434 with /v1/." Classes="muted" TextWrapping="Wrap"/>
            <WrapPanel Orientation="Horizontal">
              <Button Content="CONNECT / REFRESH" Classes="primary" Margin="0,0,8,0" Click="ApiConnect_OnClick"/>
              <Button Content="NEW CONNECTION" Margin="0,0,8,0" Click="ApiNew_OnClick"/>
              <Button Content="DISCONNECT" Click="ApiDisconnect_OnClick"/>
            </WrapPanel>
            <TextBlock x:Name="ApiConnectionStatus" Text="No API connection selected." TextWrapping="Wrap" Classes="muted"/>
          </StackPanel></Border>
          <Border x:Name="ApiModelPanel" Classes="panel" Padding="16"><StackPanel Spacing="10">
            <TextBlock Text="MODEL CAPABILITIES" Classes="micro" Foreground="#65C7D0"/>
            <TextBlock Text="Model IDs come from your endpoint. Some catalogs do not publish capabilities or allowed reasoning values. Only configure overrides below when you have verified them for the selected model. Blank options leave the provider default unchanged." TextWrapping="Wrap" Classes="muted"/>
            <ComboBox x:Name="ApiModelPicker" HorizontalAlignment="Stretch" PlaceholderText="Connect to load models" SelectionChanged="ApiModel_OnChanged"/>
            <TextBlock x:Name="ApiModelMetadataStatus" TextWrapping="Wrap" Classes="muted"/>
            <WrapPanel><CheckBox x:Name="ApiModelTools" Content="Workspace tools" Margin="0,0,20,0"/><CheckBox x:Name="ApiModelImages" Content="Image input"/></WrapPanel>
            <TextBox x:Name="ApiModelContext" Watermark="Context limit in tokens · blank if unknown"/>
            <TextBox x:Name="ApiModelReasoning" Watermark="Verified reasoning values, comma-separated · blank for provider default"/>
            <TextBox x:Name="ApiModelTiers" Watermark="Verified service-tier values, comma-separated · blank for provider default"/>
            <WrapPanel><Button Content="SAVE MODEL OVERRIDE" Margin="0,0,8,0" Click="ApiSaveModel_OnClick"/><Button Content="USE PROVIDER METADATA" Click="ApiResetModel_OnClick"/></WrapPanel>
            <TextBlock Text="This first API adapter supports streamed text, text/image attachments, and client tools. Video/audio, provider-hosted tools, image generation, and native compaction are not enabled yet. Approve for me falls back to asking for every API write or command; commands have no OS sandbox." Classes="muted" TextWrapping="Wrap"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="SKILLS">
        <Grid Margin="20,8" RowDefinitions="Auto,12,Auto,8,Auto,8,Auto,10,*">
          <Grid ColumnDefinitions="*,Auto,24,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="Skills Library" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock Text="Discover complete GitHub skill sources, cache descriptions, and install only what you choose." Classes="muted"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding SkillReportedSummary}" Classes="micro" Foreground="#65C7D0" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding SkillSourceSummary}" Classes="micro" FontSize="8" HorizontalAlignment="Right"/>
            </StackPanel>
            <Button x:Name="SkillSyncButton" Grid.Column="3" Content="↻  SYNC CATALOG" VerticalAlignment="Center" Click="SyncSkillCatalog_OnClick"/>
          </Grid>

          <Border Grid.Row="2" Classes="panel" Padding="10">
            <Grid ColumnDefinitions="*,8,155,8,135,8,205,8,150,8,Auto">
              <TextBox x:Name="SkillSearchBox" Watermark="Search names, descriptions, tasks, or frameworks…" Text="{Binding SkillSearchText, Mode=TwoWay}" KeyDown="SkillSearch_OnKeyDown"/>
              <ComboBox Grid.Column="2" ItemsSource="{Binding SkillSources}" SelectedItem="{Binding SelectedSkillSource, Mode=TwoWay}" SelectionChanged="SkillFilter_OnChanged"/>
              <ComboBox Grid.Column="4" ItemsSource="{Binding SkillStatuses}" SelectedItem="{Binding SelectedSkillStatus, Mode=TwoWay}" SelectionChanged="SkillFilter_OnChanged"/>
              <ComboBox Grid.Column="6" ItemsSource="{Binding SkillCompatibilityOptions}" SelectedItem="{Binding SelectedSkillCompatibility, Mode=TwoWay}" SelectionChanged="SkillFilter_OnChanged"/>
              <ComboBox Grid.Column="8" ItemsSource="{Binding SkillSorts}" SelectedItem="{Binding SelectedSkillSort, Mode=TwoWay}" SelectionChanged="SkillFilter_OnChanged"/>
              <Button Grid.Column="10" Content="SEARCH GITHUB" Classes="primary" Click="SearchSkills_OnClick"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="ALL TOPICS" Tag="All" Click="SkillTopic_OnClick"/>
              <Button Content="GAME DEV" Tag="Game development" Click="SkillTopic_OnClick"/>
              <Button Content="FRONTEND" Tag="Frontend" Click="SkillTopic_OnClick"/>
              <Button Content="BACKEND" Tag="Backend" Click="SkillTopic_OnClick"/>
              <Button Content="DEVOPS" Tag="DevOps" Click="SkillTopic_OnClick"/>
              <Button Content="SECURITY" Tag="Security" Click="SkillTopic_OnClick"/>
              <Button Content="DATA" Tag="Data" Click="SkillTopic_OnClick"/>
              <Button Content="TESTING" Tag="Testing" Click="SkillTopic_OnClick"/>
              <Button Content="DOCUMENTS" Tag="Documents" Click="SkillTopic_OnClick"/>
              <Button Content="MEDIA" Tag="Media" Click="SkillTopic_OnClick"/>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="6" Background="#151A21" BorderBrush="#29313C" BorderThickness="1" CornerRadius="4" Padding="8,6">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,12,*">
              <TextBlock Text="SOURCE LEDGER" Classes="micro" Foreground="#65C7D0" VerticalAlignment="Center"/>
              <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SkillSourceLedger}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillSourceItem">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Repository}" Classes="mono" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Count}" Classes="micro" FontSize="9" Foreground="#D8DEE8" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Indexed}" Classes="micro" FontSize="9" Foreground="#8993A3" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding State}" Classes="micro" FontSize="9" Foreground="{Binding StateColor}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0" Text="{Binding SkillCatalogStatus}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>

          <Grid Grid.Row="8" ColumnDefinitions="5*,12,2*">
            <Border Classes="panel" Padding="0">
              <Grid RowDefinitions="34,*">
                <Grid Margin="12,0" ColumnDefinitions="*,105,155,82">
                  <TextBlock Text="SKILL / DESCRIPTION" Classes="micro" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="TOPIC" Classes="micro" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="SOURCE" Classes="micro" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="STATUS" Classes="micro" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill, Mode=TwoWay}" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillCatalogItem">
                      <Border BorderBrush="#29313C" BorderThickness="0,1,0,0" Padding="12,8" MinHeight="66">
                        <Grid ColumnDefinitions="*,105,155,82">
                          <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                            <TextBlock Text="{Binding CompatibilityStatus}" Classes="micro" FontSize="9" Foreground="#8993A3" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Category}" Classes="micro" FontSize="8" Foreground="{Binding SpineColor}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding Repository}" Classes="mono" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SourceRevision}" Classes="muted mono" FontSize="9"/>
                          </StackPanel>
                          <Button Grid.Column="3" Content="{Binding InstallState}" Tag="{Binding}" IsEnabled="{Binding CanInstall}" Click="InstallSkill_OnClick" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="72"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="2" Classes="panel" Padding="16" IsVisible="{Binding HasSelectedSkill}">
              <Grid RowDefinitions="*,12,Auto">
                <ScrollViewer>
                  <StackPanel Spacing="13">
                    <StackPanel Spacing="4">
                      <TextBlock Text="SELECTED SKILL" Classes="micro" Foreground="#65C7D0"/>
                      <TextBlock Text="{Binding SelectedSkill.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding SelectedSkill.Description}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Height="1" Background="#29313C"/>
                    <StackPanel Spacing="5">
                      <TextBlock Text="COMPATIBILITY" Classes="micro"/>
                      <TextBlock Text="{Binding SelectedSkill.Compatibility}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                      <TextBlock Text="SOURCE" Classes="micro"/>
                      <TextBlock Text="{Binding SelectedSkill.Repository}" Classes="mono" FontSize="10" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding SelectedSkill.SourcePath}" Classes="muted mono" FontSize="9" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding SelectedSkill.SourceRevision}" Classes="muted mono" FontSize="9"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                      <TextBlock Text="PROVENANCE" Classes="micro"/>
                      <TextBlock Text="{Binding SelectedSkill.TrustState}" Foreground="#E2A84A" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="Catalog sync reads SKILL.md metadata only. Install inspects the selected package tree and asks before downloading its files." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                  <Button Content="VIEW SOURCE" Click="ViewSkillSource_OnClick"/>
                  <Button x:Name="SkillInstallButton" Content="INSTALL…" Classes="primary" IsEnabled="{Binding CanInstallSelectedSkill}" Click="InstallSkill_OnClick"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="GITHUB">
        <StackPanel Margin="24,8" Spacing="18" MaxWidth="620">
          <StackPanel Spacing="4">
            <TextBlock Text="GitHub connection" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Connect the GitHub account Harness should use across workspaces. Authentication persists until GitHub expires or revokes it." Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Classes="panel" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="ACCOUNT" Classes="micro" Foreground="#65C7D0"/>
              <TextBlock Text="{Binding GitHubStatus}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="GitHubConnectButton" Content="CONNECT GITHUB" Classes="primary" Click="GitHubSignIn_OnClick"/>
                <Button x:Name="GitHubRefreshButton" Content="REFRESH CONNECTION" Click="RefreshGitHub_OnClick"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="Repository setup, branches, remotes, commits, pulls, and pushes are managed from the Git controls in each workspace." Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="ADVANCED">
        <StackPanel Margin="24,8" Spacing="18" MaxWidth="680">
          <StackPanel Spacing="4">
            <TextBlock Text="Advanced" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Control how model-requested commands and file access are reviewed." Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Classes="panel" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="DEFAULT PERMISSION MODE" Classes="micro" Foreground="#65C7D0"/>
              <ComboBox x:Name="SettingsPermissionModePicker" ItemsSource="{Binding PermissionModes}" SelectedItem="{Binding SelectedPermissionMode, Mode=TwoWay}" Width="220" HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PermissionModeOption"><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding SelectedPermissionMode.Description}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="Approve for me uses the provider's safeguarded automatic reviewer. Full access disables command approval and the workspace sandbox for the active provider thread." Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="#29313C" BorderThickness="0,1,0,0" Background="#151A21">
      <Grid Margin="16,0" ColumnDefinitions="*,Auto,8,Auto"><TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center"/><Button Grid.Column="1" Content="CLOSE" Click="Close_OnClick"/><Button Grid.Column="3" Content="SAVE CHANGES" Classes="primary" Click="Save_OnClick"/></Grid>
    </Border>
  </Grid>
</Window>
