<Window
    x:Class="Harness.App.Views.TerminalWindow"
    x:DataType="vm:TerminalWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Harness.App.Controls"
    xmlns:vm="using:Harness.App.ViewModels"
    Title="Harness — Terminal"
    Width="1120" Height="680" MinWidth="720" MinHeight="420"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="44"
    WindowStartupLocation="CenterOwner"
    KeyDown="Window_OnKeyDown">
  <Grid RowDefinitions="44,48,*,52,28" Background="#11151B">
    <Border Grid.Row="0" Classes="hairline" Background="#151A21" PointerPressed="TitleBar_OnPointerPressed">
      <Grid Margin="14,0,0,0" ColumnDefinitions="Auto,12,Auto,12,Auto,*,40,40,40">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <controls:HarnessMark />
          <TextBlock Text="TERMINAL" Classes="micro" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="1" Width="1" Height="18" Background="#29313C"/>
        <TextBlock Grid.Column="2" Text="{Binding WorkspaceName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Grid.Column="3" Width="1" Height="18" Background="#29313C"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Border Width="6" Height="6" CornerRadius="3" Background="#65C7D0"/>
          <TextBlock Text="{Binding Status}" Classes="micro" FontSize="8" Foreground="#65C7D0"/>
        </StackPanel>
        <Button Grid.Column="6" Classes="window-command" Click="Minimize_OnClick" ToolTip.Tip="Minimize"><Border Width="12" Height="1.5" Background="#D8DEE8"/></Button>
        <Button Grid.Column="7" Classes="window-command" Click="Maximize_OnClick" ToolTip.Tip="Maximize"><Border Width="11" Height="11" BorderBrush="#D8DEE8" BorderThickness="1.5"/></Button>
        <Button Grid.Column="8" Classes="window-command window-close" Click="Close_OnClick" ToolTip.Tip="Close"><Path Width="14" Height="14" Stretch="Uniform" Stroke="#D8DEE8" StrokeThickness="1.5" Data="M3,3 L13,13 M13,3 L3,13"/></Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#151A21" BorderBrush="#29313C" BorderThickness="0,0,0,1" Padding="15,0">
      <Grid ColumnDefinitions="Auto,10,*,Auto,6,Auto" VerticalAlignment="Center">
        <Border Width="28" Height="26" CornerRadius="3" Background="#202731" BorderBrush="#35404D" BorderThickness="1">
          <TextBlock Text=">_" Classes="mono" Foreground="#65C7D0" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding ShellName}" Classes="micro" FontSize="8" Foreground="#D8DEE8"/>
          <TextBlock Text="{Binding WorkspacePath}" Classes="muted mono" FontSize="9" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button x:Name="TerminalClearButton" Grid.Column="3" Content="CLEAR" Classes="ghost" Click="Clear_OnClick" ToolTip.Tip="Clear visible terminal output (Ctrl+L)"/>
        <Button x:Name="TerminalRestartButton" Grid.Column="5" Content="RESTART SHELL" Click="Restart_OnClick" ToolTip.Tip="Stop the current shell and start a clean one"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="14,12,14,0" Background="#0D1116" BorderBrush="#29313C" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
      <Grid ColumnDefinitions="3,*">
        <Border Background="#65C7D0" Opacity="0.72"/>
        <TextBox x:Name="TerminalOutputBox"
                 Grid.Column="1"
                 Text="{Binding OutputText}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                 FontSize="12"
                 LineHeight="19"
                 Padding="14,12"
                 BorderThickness="0"
                 Background="#0D1116"
                 SelectionBrush="#65C7D0"
                 SelectionForegroundBrush="#11151B"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </Grid>
    </Border>

    <Border Grid.Row="3" Margin="14,8,14,10" Classes="panel" Padding="7,5">
      <Grid ColumnDefinitions="24,*,8,Auto">
        <TextBlock Text="›" Foreground="#65C7D0" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="TerminalCommandBox"
                 Grid.Column="1"
                 Text="{Binding CommandText, Mode=TwoWay}"
                 Watermark="Run a command in this workspace…"
                 FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                 FontSize="12"
                 BorderThickness="0"
                 Background="Transparent"
                 VerticalContentAlignment="Center"
                 KeyDown="CommandBox_OnKeyDown"/>
        <Button x:Name="TerminalRunButton" Grid.Column="3" Content="RUN  ↵" Classes="primary" IsEnabled="{Binding CanSend}" Click="Run_OnClick"/>
      </Grid>
    </Border>

    <Border Grid.Row="4" BorderBrush="#29313C" BorderThickness="0,1,0,0" Background="#0D1116">
      <Grid Margin="11,0" ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="USER SHELL · DIRECT INPUT" Classes="micro" FontSize="8" Foreground="#65C7D0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="Commands entered here run as you; agent commands still follow Harness permissions." Classes="muted" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="↑↓ HISTORY  ·  CTRL+L CLEAR" Classes="muted mono" FontSize="8" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
