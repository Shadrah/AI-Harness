<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Harness.App.Controls" x:Class="Harness.App.Views.BrowserWindow"
        Title="Harness — Reference browser" Width="1100" Height="760" MinWidth="720" MinHeight="480"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="46" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="46,Auto,*,Auto" Background="#11151B">
    <Border Background="#181E26" Padding="14,4,0,0" PointerPressed="TitleBar_OnPointerPressed">
      <Grid ColumnDefinitions="*,40,40,40">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <controls:HarnessMark />
          <TextBlock Text="REFERENCE BROWSER" Classes="micro" Foreground="#65C7D0"/>
          <TextBlock x:Name="SessionLabel" Foreground="#8993A3" TextTrimming="CharacterEllipsis" MaxWidth="470"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="window-command" Click="Minimize_OnClick" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize browser"><Border Width="12" Height="1.5" Background="#D8DEE8"/></Button>
        <Button Grid.Column="2" Classes="window-command" Click="Maximize_OnClick" ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize browser"><Border Width="11" Height="11" BorderBrush="#D8DEE8" BorderThickness="1.5"/></Button>
        <Button Grid.Column="3" Classes="window-command window-close" Click="Close_OnClick" ToolTip.Tip="Close and revoke agent access" AutomationProperties.Name="Close browser"><Path Width="14" Height="14" Stroke="#D8DEE8" StrokeThickness="1.5" Data="M1,1 L13,13 M13,1 L1,13"/></Button>
      </Grid>
    </Border>
    <Border Grid.Row="1" Padding="12" Background="#181E26" BorderBrush="#35404D" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="icon-button" Click="Back_OnClick" ToolTip.Tip="Back" AutomationProperties.Name="Back"><Path Width="14" Height="14" Stroke="#D8DEE8" StrokeThickness="1.5" Data="M7,1 L1,7 L7,13 M1,7 L13,7"/></Button>
          <Button Classes="icon-button" Click="Forward_OnClick" ToolTip.Tip="Forward" AutomationProperties.Name="Forward"><Path Width="14" Height="14" Stroke="#D8DEE8" StrokeThickness="1.5" Data="M7,1 L13,7 L7,13 M1,7 L13,7"/></Button>
          <Button Classes="icon-button" Click="Reload_OnClick" ToolTip.Tip="Reload" AutomationProperties.Name="Reload"><Path Width="14" Height="14" Stroke="#D8DEE8" StrokeThickness="1.5" Data="M12,5 A5,5 0 1 0 12,10 M8,5 L13,5 L13,0"/></Button>
        </StackPanel>
        <TextBox x:Name="Address" Grid.Column="1" Watermark="Paste a video or reference URL…" KeyDown="Address_OnKeyDown" VerticalContentAlignment="Center"/>
        <Button x:Name="GoButton" Grid.Column="2" Content="OPEN" Click="Go_OnClick" Classes="primary"/>
        <CheckBox x:Name="AgentAccess" Grid.Column="3" Content="Agent access" VerticalAlignment="Center" ToolTip.Tip="Allow this chat to read page text and send screenshots to the selected model provider. Turn off to revoke access immediately."/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <controls:BrowserHost x:Name="Browser"/>
      <Border x:Name="LoadingPanel" Background="#11151B" Padding="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="570" Spacing="12">
          <TextBlock Text="A browser for this task" FontSize="24" Foreground="#D8DEE8"/>
          <TextBlock x:Name="LoadingText" Text="Starting the isolated browser…" TextWrapping="Wrap" Foreground="#8993A3"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#181E26" Padding="12,8" BorderBrush="#35404D" BorderThickness="0,1,0,0">
      <StackPanel Spacing="4">
        <TextBlock x:Name="BrowserStatus" Text="Browser access is scoped to this chat." Foreground="#65C7D0" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Isolated profile · Downloads and popups blocked · Frames + visible captions; no audio capture" FontSize="10" Foreground="#8993A3"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
